# OS
.DS_Store

# Bun installs
node_modules/

# Secrets — never commit real credentials, only *.env.example templates
.env
.env.local
env.local
.env.*
!.env.example

# Æion Template local state: reference clone, sessions, settings, reviews
.aeion/
work/handovers/
# Evaluation records grow with every run and stay on this machine.
tools/evals/results.jsonl
# .factory/ belongs to Factory's Droid; only its config is tracked, older local state stays ignored.
.factory/*
!.factory/settings.json
!.factory/README.md

# Python tooling caches used by the template checks
__pycache__/
*.pyc
.venv/

# Next.js on Bun: build output and generated type stubs
.next/
next-env.d.ts
*.tsbuildinfo

# SQLite runtime data (per-app TEST databases, regenerated on first run)
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs
*.log

# Local temporary AI tooling (never tracked or shipped)
temporary_tools/
