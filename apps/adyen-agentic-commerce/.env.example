# Adyen TEST only: a LIVE client key or ADYEN_ENVIRONMENT=LIVE stops the app at boot.
# Read by tools/dev/bun-app.ts (bun run dev:agentic); the shell wins over this file.
PORT=8003
PUBLIC_ORIGIN=http://127.0.0.1:8003
DATABASE_PATH=./data/agentic.sqlite

# Customer Area > Developers > API credentials (TEST). The key needs the Checkout API role.
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
# Client key of the same credential, starting with test_; add the store origin to its allowed origins.
ADYEN_CLIENT_KEY=
# Standard webhook HMAC key (hex). Without it every webhook is rejected.
ADYEN_HMAC_KEY=

# Optional: protects the Back Office and the consent decision with HTTP basic auth.
PLAYGROUND_BASIC_AUTH_USER=
PLAYGROUND_BASIC_AUTH_PASSWORD=

# Ask agent (knowledge/components/ask-agent.md). Keys stay on the server; shoppers never see or
# choose a model. Set at least the key of the answer model's provider, or the chat stays off.
ASK_AGENT_ENABLED=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# provider/model from Pi's catalogue (openai, anthropic, mistral, deepseek); the console can
# override them. Effort: off, minimal, low, medium, high, xhigh, max.
ASK_AGENT_MODEL=openai/gpt-6.2-sol
ASK_AGENT_EFFORT=low
ASK_GUARD_MODEL=openai/gpt-5.4-mini
ASK_GUARD_EFFORT=minimal
# Limits (defaults shown); the console can change them within fixed ranges. Costs in USD.
ASK_SESSION_MAX_MINUTES=30
ASK_SESSION_IDLE_MINUTES=10
ASK_SESSION_MAX_MESSAGES=40
ASK_MAX_MODEL_CALLS=6
ASK_SESSION_BUDGET_USD=0.5
ASK_DAILY_BUDGET_USD=5
# Voice (GPT-Live, OpenAI conversations only), unlocked with VOICE_MODE_PASSWORD (any length;
# unset, voice is not offered).
ASK_VOICE_ENABLED=true
ASK_VOICE_MODEL=gpt-live-1.1
ASK_VOICE_MAX_MINUTES=10
ASK_VOICE_DAILY_MINUTES=30
VOICE_MODE_PASSWORD=

# Atelier Velune console at /console. At least 16 characters, or the console does not exist.
CONSOLE_PASSWORD=
