{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "atelier-velune",
  "version": "1.0.0",
  "description": "Shop Atelier Velune, a demo fashion store on Adyen TEST: browse the collection by hand or let your assistant shop, then pay with a card saved in your store account.",
  "author": {
    "name": "Payments Playground",
    "url": "https://agentic.payments-playground.com"
  },
  "homepage": "https://agentic.payments-playground.com/docs/chatgpt",
  "keywords": ["shopping", "fashion", "ucp", "pap", "adyen", "test"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Atelier Velune",
        "shortDescription": "Adyen TEST demo fashion store",
        "longDescription": "Browse the Atelier Velune collection in a carousel, choose colour and size, fill your bag and pay with a card saved in your store account, within the budget you set when you connect. Payments run on Adyen TEST: no real money moves.",
        "developerName": "Payments Playground",
        "category": "Other",
        "capabilities": ["Browse catalogue", "Manage bag", "Pay with saved card (TEST)"],
        "websiteURL": "https://agentic.payments-playground.com",
        "supportURL": "https://agentic.payments-playground.com/docs/chatgpt",
        "privacyPolicyURL": "https://agentic.payments-playground.com/legal#privacy",
        "termsOfServiceURL": "https://agentic.payments-playground.com/legal#terms",
        "defaultPrompt": [
          "Find me a trench coat from Atelier Velune.",
          "Show me bags under 150 EUR.",
          "Show my Atelier Velune bag."
        ],
        "brandColor": "#004526",
        "logo": "./assets/logo.svg",
        "composerIcon": "./assets/icon.svg"
      }
    }
  }
}
