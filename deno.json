{
  "workspace": [
    "apps/adyen-digital",
    "apps/adyen-ipp-endless-aisle",
    "apps/adyen-v6-styling"
  ],
  "nodeModulesDir": "auto",
  "exclude": ["apps/adyen-agentic-commerce"],
  "imports": {
    "@suite/platform/": "./packages/platform/",
    "@suite/ui/": "./packages/ui/",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@0.225.7",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/yaml": "jsr:@std/yaml@1.2.0",
    "@db/sqlite": "jsr:@db/sqlite@0.13.0",
    "hono": "jsr:@hono/hono@4.12.31",
    "fresh": "jsr:@fresh/core@2.3.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@1.1.2",
    "preact": "npm:preact@10.29.8",
    "@preact/signals": "npm:@preact/signals@2.9.0",
    "@adyen/api-library": "npm:@adyen/api-library@32.3.0",
    "@adyen/adyen-web": "npm:@adyen/adyen-web@6.48.1",
    "vite": "npm:vite@7.1.4",
    "esbuild": "npm:esbuild@0.25.12"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ]
  },
  "tasks": {
    "dev:all": "deno run -A tools/dev/dev-all.ts",
    "dev:digital": "deno task --cwd apps/adyen-digital dev --port 8001",
    "dev:ipp": "deno task --cwd apps/adyen-ipp-endless-aisle dev --port 8002",
    "dev:agentic": "deno run -A tools/dev/bun-app.ts apps/adyen-agentic-commerce dev",
    "dev:styling": "deno task --cwd apps/adyen-v6-styling dev --port 8004",
    "env:migrate": "deno run -A tools/dev/migrate-legacy-env.ts",
    "start:all": "deno run -A tools/dev/start-all.ts",
    "build:digital": "deno task --cwd apps/adyen-digital build",
    "build:ipp": "deno task --cwd apps/adyen-ipp-endless-aisle build",
    "build:agentic": "cd apps/adyen-agentic-commerce && bun install --frozen-lockfile && bun run build",
    "build:styling": "deno task --cwd apps/adyen-v6-styling build",
    "build": "deno task build:digital && deno task build:ipp && deno task build:agentic && deno task build:styling",
    "test": "deno test -A packages apps tools/knowledge",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint packages apps tools/dev tools/build tools/knowledge",
    "knowledge:check": "deno run --allow-read tools/knowledge/knowledge-check.ts",
    "docs:links": "python3 tools/knowledge/doc-links",
    "repo:health": "python3 tools/repo-health/repo-health",
    "template:test": "tools/template-tests",
    "types": "deno check packages/**/*.ts packages/**/*.tsx apps/adyen-digital/**/*.ts apps/adyen-digital/**/*.tsx apps/adyen-ipp-endless-aisle/**/*.ts apps/adyen-ipp-endless-aisle/**/*.tsx apps/adyen-v6-styling/**/*.ts apps/adyen-v6-styling/**/*.tsx tools/dev/**/*.ts tools/build/**/*.ts tools/knowledge/**/*.ts",
    "ssr:assert": "deno run -A tools/build/assert-built-ssr.ts apps/adyen-digital \"Digital Checkout\" && deno run -A tools/build/assert-built-ssr.ts apps/adyen-ipp-endless-aisle \"Endless Aisle\" && deno run -A tools/build/assert-built-ssr.ts apps/adyen-v6-styling \"Drop-in Styling\"",
    "check:agentic": "cd apps/adyen-agentic-commerce && bun install --frozen-lockfile && bun run typecheck && bun test",
    "check": "deno task fmt:check && deno task lint && deno task knowledge:check && deno task docs:links && deno task repo:health && deno task types && deno task test && deno task check:agentic && deno task build && deno task ssr:assert && deno task template:test",
    "verify": "deno task build && deno run -A tools/dev/verify.ts"
  },
  "fmt": {
    "exclude": [
      "**/_fresh",
      "**/node_modules",
      ".aeion",
      "loops",
      "tech-watch",
      ".claude",
      ".agents",
      ".codex",
      ".opencode",
      ".pi",
      ".dsh",
      ".devin",
      ".factory",
      "tools/agents",
      "tools/context",
      "tools/git-hooks",
      "tools/loops",
      "tools/release",
      "tools/repo-health",
      "tools/skills"
    ],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "exclude": [
      "**/_fresh",
      "**/node_modules",
      ".aeion",
      "loops",
      "tech-watch",
      ".claude",
      ".agents",
      ".codex",
      ".opencode",
      ".pi",
      ".dsh",
      ".devin",
      ".factory",
      "tools/agents",
      "tools/context",
      "tools/git-hooks",
      "tools/loops",
      "tools/release",
      "tools/repo-health",
      "tools/skills"
    ],
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ],
      "exclude": [
        "no-window-prefix"
      ]
    }
  }
}
