{
  "workspace": [
    "apps/adyen-digital",
    "apps/adyen-ipp-endless-aisle",
    "apps/adyen-agentic-commerce",
    "apps/adyen-v6-styling"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@suite/platform/": "./packages/platform/",
    "@suite/ui/": "./packages/ui/",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@0.225.7",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/yaml": "jsr:@std/yaml@1.2.0",
    "@db/sqlite": "jsr:@db/sqlite@0.13.0",
    "hono": "jsr:@hono/hono@4.12.31",
    "fresh": "jsr:@fresh/core@2.3.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@1.1.2",
    "preact": "npm:preact@10.29.8",
    "@preact/signals": "npm:@preact/signals@2.9.0",
    "@adyen/api-library": "npm:@adyen/api-library@32.0.0",
    "@adyen/adyen-web": "npm:@adyen/adyen-web@6.46.0",
    "vite": "npm:vite@7.1.4",
    "esbuild": "npm:esbuild@0.25.12"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ]
  },
  "tasks": {
    "dev:all": "deno run -A scripts/dev-all.ts",
    "dev:digital": "deno task --cwd apps/adyen-digital dev --port 8001",
    "dev:ipp": "deno task --cwd apps/adyen-ipp-endless-aisle dev --port 8002",
    "dev:agentic": "deno task --cwd apps/adyen-agentic-commerce dev --port 8003",
    "dev:styling": "deno task --cwd apps/adyen-v6-styling dev --port 8004",
    "env:migrate": "deno run -A scripts/migrate-legacy-env.ts",
    "start:all": "deno run -A scripts/start-all.ts",
    "build:digital": "deno task --cwd apps/adyen-digital build",
    "build:ipp": "deno task --cwd apps/adyen-ipp-endless-aisle build",
    "build:agentic": "deno task --cwd apps/adyen-agentic-commerce build",
    "build:styling": "deno task --cwd apps/adyen-v6-styling build",
    "build": "deno task build:digital && deno task build:ipp && deno task build:agentic && deno task build:styling",
    "test": "deno test -A --parallel packages apps scripts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint packages apps scripts",
    "knowledge:check": "deno run --allow-read scripts/knowledge-check.ts",
    "types": "deno check packages/**/*.ts packages/**/*.tsx apps/**/*.ts apps/**/*.tsx scripts/**/*.ts",
    "ssr:assert": "deno run -A scripts/assert-built-ssr.ts apps/adyen-digital \"Digital Checkout\" && deno run -A scripts/assert-built-ssr.ts apps/adyen-ipp-endless-aisle \"Endless Aisle\" && deno run -A scripts/assert-built-ssr.ts apps/adyen-agentic-commerce \"Agentic Commerce\" && deno run -A scripts/assert-built-ssr.ts apps/adyen-v6-styling \"Drop-in Styling\"",
    "check": "deno task fmt:check && deno task lint && deno task knowledge:check && deno task types && deno task test && deno task build && deno task ssr:assert",
    "verify": "deno task build && deno run -A scripts/verify.ts"
  },
  "fmt": {
    "exclude": [
      "**/_fresh",
      "**/node_modules"
    ],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "exclude": [
      "**/_fresh",
      "**/node_modules"
    ],
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ],
      "exclude": [
        "no-window-prefix"
      ]
    }
  }
}
