#!/usr/bin/env python3
# Spec: knowledge/operations/context-safety.md
"""Launch the supported checkpoint profile; strict admission is explicitly unsupported."""
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[2]
arguments = sys.argv[1:]
if "--strict" in arguments:
    sys.exit("UNSUPPORTED: strict pre-request 390k admission has not been qualified for this runtime.")
if any(value.startswith("--autocompact") for value in arguments):
    sys.exit("Æion Template owns --autocompact; use the 340000-token checkpoint profile.")
if os.environ.get("DISABLE_AUTO_COMPACT") or os.environ.get("DISABLE_COMPACT"):
    sys.exit("Æion Template requires native compaction; remove the disabling environment override.")
os.environ["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = "340000"
os.chdir(root)
try:
    os.execvp("claude", ["claude", "--autocompact", "340000", *arguments])
except FileNotFoundError:
    sys.exit("claude is not installed or not on PATH; see knowledge/operations/getting-started.md#prepare-your-agent")
