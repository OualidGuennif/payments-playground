#!/usr/bin/env bash
# Spec: knowledge/operations/build-and-test.md
# The factory's own test suites, in the order CI runs them; the first failure stops the run.
# One command keeps AGENTS.md short enough for a project to add its own build lines.
set -euo pipefail
cd "$(dirname "$0")/.."

run() {
  echo "== $*"
  "$@"
}

run python3 tools/knowledge/tests/test_doc_links.py
run deno test -A tools/knowledge/knowledge-check.test.ts
run python3 tools/repo-health/tests/test_repo_health.py
run python3 tools/git-hooks/tests/test_pre_push.py
run python3 tools/release/tests/test_release.py
run python3 tools/architecture/tests/test_refresh.py
run python3 tools/architecture/tests/test_ask.py
run python3 tools/architecture/tests/test_gallery.py
# The harness, context and loop suites join this runner with those tools.
echo "factory-tests: PASS"
